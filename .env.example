# Database Connection (PostgreSQL for production; Prisma supports PostgreSQL & SQLite)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/resumeforge?schema=public"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication Secret (Used for session token encryption & verification)
AUTH_SECRET="resumeforge-ai-super-secret-production-key-change-me"

# Exclusive AI Provider: Google Gemini API (@google/genai)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_COMPLEX_MODEL="gemini-1.5-pro"
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=3

# Optional: Clerk Authentication (if using Clerk instead of native JWT auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# LinkedIn OAuth 2.0 Integration (Official OpenID Connect scopes: openid, profile, email)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:3000/api/auth/linkedin/callback"
